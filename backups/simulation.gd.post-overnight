func _init_armies() -> void:
	for si in gen.states.size():
		var s: Dictionary = gen.states[si]
		var power := _state_power(si)
		s.army = maxi(1, power / 900)
		s.warships = maxi(0, s.provinces.size() / 4)

func apply_mods() -> void:
	# F4：mods 目录中的 .json 与内置规则浅合并，独立启用/关闭
	var dir := DirAccess.open("user://")
	if dir == null:
		return
	if not dir.dir_exists("mods"):
		return
	dir = DirAccess.open("user://mods")
	for f in dir.get_files():
		if f.ends_with(".json"):
			var txt := FileAccess.get_file_as_string("user://mods/" + f)
			var data: Variant = JSON.parse_string(txt)
			if data is Dictionary:
				for k in data:
					if rules.has(k):
						rules[k] = data[k]
						history.append({"date": date_str(), "text": "[mod] %s 覆盖规则 %s = %s" % [f, k, str(data[k])]})

func date_str() -> String:
	return "公元%d年-%d-%d" % [year, month, day]

func tick_month() -> void:
	month += 1
	if month > 12:
		month = 1
		year += 1
	_leader_tick()
	_grow_population()
	_economy_tick()
	_advance_armies()
	_advance_truces()
	_diplomacy_and_war()
	_try_alliances()
	_abandon_isolated_provinces()
	map_changed.emit()

## 领袖生命周期（P6 最小实现，重建规则标注）：年初年龄 +1；65 岁起每月 2% 死亡、75 岁必死；
## 继任者姓名取自原版文化包 CSV（CharacterFirstNames_M/F + CharacterLastNames，★A 数据）；
## 死亡写入历史。原版 LeaderDeathEvent/LeaderAscensionEvent 的继承族系规则待 round12 真值。
var _leader_rng := RandomNumberGenerator.new()

func _leader_tick() -> void:
	var cs = gen.get("_culture_sys") if gen != null else null
	if cs == null:
		return
	for si in _alive_states():
		var st: Dictionary = gen.states[si]
		var leader: Dictionary = st.get("leader", {})
		if leader.is_empty() or not leader.has("name"):
			continue
		if month == 1:
			leader["age"] = int(leader.get("age", 30)) + 1
		var age: int = int(leader.get("age", 30))
		var die_p: float = 0.0
		if age >= 75:
			die_p = 1.0
		elif age >= 65:
			die_p = 0.02
		if age >= 65 and _leader_rng.randf() < die_p:
			var old_name: String = str(leader.get("name", "?"))
			var nk: Dictionary = _gen_successor(si, cs)
			st["leader"] = nk
			history.append({"date": date_str(),
				"text": "【领袖】%s 领袖 %s 去世，%s 继位（%d 岁）" % [st.name, old_name, str(nk["name"]), int(nk["age"])],
				"state": si})

## 名字池元素为原版 CSV 的 {key,zh,en} 字典（culture_pack._load_csv_names），取中文名；字符串则直用
func _pick_name(arr: Array) -> String:
	if arr.is_empty():
		return ""
	var v: Variant = arr[_leader_rng.randi() % arr.size()]
	if v is Dictionary:
		return str((v as Dictionary).get("zh", ""))
	return str(v)

func _gen_successor(si: int, cs) -> Dictionary:
	var pools: Dictionary = cs.leader_name_pools(si)
	var male: Array = pools.get("male", [])
	var female: Array = pools.get("female", [])
	var last: Array = pools.get("last", [])
	var is_male := _leader_rng.randf() < 0.78
	var given: Array = male if is_male else female
	var first := _pick_name(given)
	if first == "":
		first = "无名"
	var nm := first
	var ln := _pick_name(last)
	if ln != "":
		nm = ln + first
	return {"name": nm, "gender": "男" if is_male else "女", "age": _leader_rng.randi_range(18, 48)}

## 月度财政循环（第十一轮补充，方向调整后第一项玩法实现）。
## 【证据边界】字段名 gold/goldPerMonth/foodReserve/armyCostGold 为原版 schema（官渡存档解密实测）；
## 具体收支公式未从原版反编译（Town/经济类待读）——当前公式为重建版实现并显式标注，
## 结构上保证：国家有真实月度收入/支出/赤字后果，参与存档。
func _economy_tick() -> void:
	for si in _alive_states():
		var st: Dictionary = gen.states[si]
		var income := 0.0
		for pi in st.get("provinces", []):
			var prov: Dictionary = gen.provinces[pi]
			# 税基 = 省人口；每千人月税 1 金（重建版公式，标注待证据）
			income += float(prov.get("pop", 0)) * 0.001
		# 军费：活跃战争中的国家军费加倍（战争有真实财政代价）
		var expense := float(st.get("army_cost", 0)) * (2.0 if is_at_war(si) else 1.0)
		var gold: float = float(st.get("gold", 0.0)) + income - expense
		# 赤字后果：金库为负 → 欠饷 → 人口流失（真实状态变化，非提示）
		if gold < 0.0:
			gold = 0.0
			for pi2 in st.get("provinces", []):
				var prov2: Dictionary = gen.provinces[pi2]
				prov2.pop = int(float(prov2.get("pop", 0)) * 0.995)

		st["gold"] = gold
		st["gold_per_month"] = income - expense

## ---- 军队系统（第十一轮方向调整后实现）----
## 【证据边界】字段名与取值域 = 原版 schema（官渡/欧洲1.1.1 存档解密实测：armyID/currentCell/
## preCell/homeProvince/state/armyCount(float)/armyType(BorderGuard|FieldArmy|Garrison)/
## armyOrder("AttackEnemyProvince")/currentState/participatedCampaigns…）；
## 编成比例（边防 94.5%/野战/驻防）与兵力 200 起步 = 存档统计实测；
## 移动/战斗/占领的**逐步规则**为重建版实现（原版逐步逻辑在 main.js/Campaign 类，待反编译），已标注。
func _init_armies_for_state(si: int) -> void:
	var st: Dictionary = gen.states[si]
	if int(st.get("armies_initialized", 0)) == 1:
		return
	st["armies_initialized"] = 1
	var border := []
	var capital_prov: int = int(st.get("capital", -1))
	for pi in st.get("provinces", []):
		var is_border := bool(gen.provinces[pi].get("neighbors", {}).size() > 0)
		if is_border:
			border.append(pi)
	var aid_base := armies.size() + 1
	# 驻防军（首都）
	if capital_prov >= 0:
		armies.append({"army_id": aid_base, "state": si, "home_province": capital_prov,
			"current_cell": _province_cell(capital_prov), "pre_cell": -1,
			"army_count": 200.0, "army_type": "Garrison", "army_order": "HoldPosition",
			"current_state": "Idle", "target_province": -1, "is_elite": false,
			"is_manual_created": false, "is_emergency_call": false,
			"base_combat_efficiency": 1.0, "founding_time": float(year),
			"participated_campaigns": [], "enemy_army_destroyed_count": 0.0,
			"conquered_provinces_info": []})
		aid_base += 1
	# 边防军（每 2 个边境省 1 支，上限 40 支）
	var bg := 0
	for pi2 in border:
		if bg >= 40:
			break
		if pi2 % 2 == 0:
			armies.append({"army_id": aid_base, "state": si, "home_province": pi2,
				"current_cell": _province_cell(pi2), "pre_cell": -1,
				"army_count": 200.0, "army_type": "BorderGuard", "army_order": "GuardBorder",
				"current_state": "Idle", "target_province": -1, "is_elite": false,
				"is_manual_created": false, "is_emergency_call": false,
				"base_combat_efficiency": 1.0, "founding_time": float(year),
				"participated_campaigns": [], "enemy_army_destroyed_count": 0.0,
				"conquered_provinces_info": []})
			aid_base += 1
			bg += 1
	# 野战军（1 支，首都附近）
	if capital_prov >= 0:
		armies.append({"army_id": aid_base, "state": si, "home_province": capital_prov,
			"current_cell": _province_cell(capital_prov), "pre_cell": -1,
			"army_count": 200.0, "army_type": "FieldArmy", "army_order": "HoldPosition",
			"current_state": "Idle", "target_province": -1, "is_elite": false,
			"is_manual_created": false, "is_emergency_call": false,
			"base_combat_efficiency": 1.0, "founding_time": float(year),
			"participated_campaigns": [], "enemy_army_destroyed_count": 0.0,
			"conquered_provinces_info": []})

func _province_cell(pi: int) -> int:
	var cells: PackedInt32Array = gen.provinces[pi].get("cells", PackedInt32Array())
	if cells.size() == 0:
		return -1
	return cells[cells.size() / 2]

## 宣战动员（重建版规则，标注）：野战军获"AttackEnemyProvince"进攻令；
## 驻防军/边防军原地留守（原版 armyType 语义：BorderGuard 94.5% 常态不主动进攻）。
func _mobilize_armies(si: int) -> void:
	for a in armies:
		if int(a["state"]) != si:
			continue
		if str(a["army_type"]) == "FieldArmy":
			a["army_order"] = "AttackEnemyProvince"
			a["current_state"] = "Marching"
			a["target_province"] = -1        # 下月推进时按当前敌国重选
			a["march_months"] = 0
		else:
			a["army_order"] = "HoldPosition"  # 留守：被入侵时在遭遇战中原地参战
			a["current_state"] = "Idle"

## 月度军队推进（重建版规则，标注）：野战军向目标省逐格推进；
## 每步检查所在省遭遇敌军（省级遭遇，不要求同格）；抵达敌省即建立控制；
## 行军超 18 个月未果自动收兵（防无限徘徊）；战争结束立即停进军令。
func _advance_armies() -> void:
	var dead := []
	for a in armies:
		if float(a["army_count"]) <= 1.0 or str(a["current_state"]) == "Destroyed":
			dead.append(a)
			continue
		if str(a["current_state"]) == "Reorganization":
			a["reorg_months"] = int(a.get("reorg_months", 2)) - 1
			if int(a["reorg_months"]) <= 0:
				a["current_state"] = "Idle"
				a["army_order"] = "HoldPosition"
				a["target_province"] = -1
				a["current_cell"] = int(a["pre_cell"]) if int(a["pre_cell"]) >= 0 else int(a["current_cell"])
			continue
		var si: int = int(a["state"])
		if not gen.states[si].get("alive", false):
			continue
		var order: String = str(a["army_order"])
		if order != "AttackEnemyProvince":
			continue
		if not is_at_war(si):
			a["army_order"] = "HoldPosition"
			a["current_state"] = "Idle"
			a["target_province"] = -1
			continue
		var cur: int = int(a["current_cell"])
		# 省级遭遇（移动前）：月初与敌军同省即交战（含同格共存、围攻）；
		# 交战后本军若进入重组/覆灭则本月不再行动
		if _check_encounter(a):
			continue
		var tgt: int = int(a["target_province"])
		# 目标有效性：省存在、仍属敌国（含被对方控制）。失效则重选。
		if tgt >= 0:
			var to: int = int(gen.provinces[tgt].get("state", -1))
			if to < 0 or not gen.states[to].alive:
				tgt = -1
			elif to == si:
				a["target_province"] = -1
				tgt = -1
		if tgt < 0:
			for nb in _neighbor_states(si):
				if is_at_war(nb):
					var tp := _border_province_of(nb, si)
					if tp >= 0:
						tgt = tp
						a["target_province"] = tp
						a["march_months"] = 0
					break
			if tgt < 0:
				continue
		# 行军超时：18 个月未抵达 → 收兵回 Idle（防无限徘徊/死循环）
		a["march_months"] = int(a.get("march_months", 0)) + 1
		if int(a["march_months"]) > 18:
			a["army_order"] = "HoldPosition"
			a["current_state"] = "Idle"
			a["target_province"] = -1
			continue
		var tprov: Dictionary = gen.provinces[tgt]
		var tcenter: Vector2 = tprov.get("burg", Vector2.ZERO)
		var best := -1
		var bd := 1 << 30
		var cx: int = cur % gen.W
		var cy: int = cur / gen.W
		for dy in range(-1, 2):
			for dx in range(-1, 2):
				if dx == 0 and dy == 0:
					continue
				var nx: int = cx + dx
				var ny: int = cy + dy
				if nx < 0 or ny < 0 or nx >= gen.W or ny >= gen.H:
					continue
				var nb: int = ny * gen.W + nx
				var pi2: int = int(gen.cell_province[nb])
				if pi2 < 0:
					continue
				var owner: int = int(gen.provinces[pi2].get("state", -1))
				# 只走己方/盟友/交战国领土（不穿越无关中立国）
				var hostile_or_own: bool = owner == si or owner < 0 or _are_hostile(owner, si)
				var allied: bool = gen.states[si].get("allies", []).has(owner)
				if not hostile_or_own and not allied:
					continue
				var d: int = absi(nx - int(tcenter.x)) + absi(ny - int(tcenter.y))
				if d < bd:
					bd = d
					best = nb
		if best >= 0 and best != cur:
			a["pre_cell"] = cur
			a["current_cell"] = best
			var pi3: int = int(gen.cell_province[best])
			if pi3 >= 0:
				var owner2: int = int(gen.provinces[pi3].get("state", -1))
				if owner2 != si:
					_occupy_province(pi3, si, a)
		# 省级遭遇（移动后）：进入敌军所在省即交战
		_check_encounter(a)
	for a in dead:
		armies.erase(a)

## 省级遭遇检查（重建版规则）：与 a 同省的交战敌军 → _battle。
## 返回 true 表示 a 已退出本月行动（战败重组或覆灭）。
func _check_encounter(a: Dictionary) -> bool:
	var si: int = int(a["state"])
	var pi_now: int = int(gen.cell_province[int(a["current_cell"])])
	if pi_now < 0:
		return false
	for e in armies:
		if e == a or str(e["current_state"]) == "Destroyed" or str(e["current_state"]) == "Reorganization":
			continue
		if int(e["state"]) == si or float(e["army_count"]) <= 1.0:
			continue
		if not _are_hostile(int(e["state"]), si):
			continue
		var epi: int = int(gen.cell_province[int(e["current_cell"])])
		if epi == pi_now:
			_battle(a, e, pi_now)
			var st_now: String = str(a["current_state"])
			return st_now == "Reorganization" or st_now == "Destroyed"
	return false

## 两国间是否存在活跃战争（a 打 d 或 d 打 a）
func is_at_war_with(sa: int, sb: int) -> bool:
	for w in wars:
		if w.active and ((int(w.a) == sa and int(w.d) == sb) or (int(w.a) == sb and int(w.d) == sa)):
			return true
	return false

func _occupy_province(pi: int, si: int, army: Dictionary) -> void:
	var from_si: int = int(gen.provinces[pi].get("state", -1))
	if from_si == si:
		return
	# 敌对军队遭遇 → 战役（Campaign，schema 原版实测）
	var enemy_army := {}
	for e in armies:
		if int(e["state"]) == from_si and int(e["current_cell"]) == int(army["current_cell"]):
			enemy_army = e
			break
	if not enemy_army.is_empty():
		_battle(army, enemy_army, pi)
		return
	gen.provinces[pi]["occupied_by"] = si
	army["conquered_provinces_info"].append({"province": pi, "from": from_si,
		"time": "%d-%d" % [year, month]})
	history.append({"date": date_str(), "text": "控制 %s" % gen.provinces[pi].get("name", ""),
		"state": si})
	if history.size() > 800:
		history = history.slice(history.size() - 600)

## 战斗（重建版公式，显式标注）：双方按 armyCount×efficiency 对拼，各损 15%~35%；
## 兵力低者败退（Reorganization 2 个月 + 退回 preCell/home），armyCount<=0 歼灭。
## 原版战斗公式在 main.js/Campaign 类（待解密），当前实现保证遭遇必有真实兵力后果。
func _battle(a: Dictionary, e: Dictionary, pi: int) -> void:
	var pa: float = float(a["army_count"]) * float(a["base_combat_efficiency"])
	var pe: float = float(e["army_count"]) * float(e["base_combat_efficiency"])
	if pa <= 0.0 or pe <= 0.0:
		return
	var camp := {"id": campaigns.size(), "war_key": "%d-%d" % [int(a["state"]), int(e["state"])],
		"location_province_id": pi, "start_time": float(year) + float(month) / 12.0,
		"end_time": 0.0, "involved_army_ids": [int(a["army_id"]), int(e["army_id"])],
		"involved_state_ids": [int(a["state"]), int(e["state"])],
		"sequence_number": 1, "is_active": true}
	a["participated_campaigns"].append(int(camp["id"]))
	e["participated_campaigns"].append(int(camp["id"]))
	var loss_a: float = pa * (_sim_rng.randf() * 0.2 + 0.15)
	var loss_e: float = pe * (_sim_rng.randf() * 0.2 + 0.15)
	a["army_count"] = maxf(0.0, pa - loss_a)
	e["army_count"] = maxf(0.0, pe - loss_e)
	var loser: Dictionary = e if a["army_count"] >= e["army_count"] else a
	var winner: Dictionary = a if a["army_count"] >= e["army_count"] else e
	if float(loser["army_count"]) <= 1.0:
		loser["current_state"] = "Destroyed"
		camp["is_active"] = false
		camp["end_time"] = float(year) + float(month) / 12.0
	else:
		loser["current_state"] = "Reorganization"
		loser["reorg_months"] = 2
		loser["current_cell"] = int(loser["pre_cell"]) if int(loser["pre_cell"]) >= 0 else int(loser["current_cell"])
	campaigns.append(camp)
	# 战斗结果联动战争分数（重建版规则：战场胜负影响战争走向，每次 ±3）
	for w in wars:
		if w.active and ((int(w.a) == int(a["state"]) and int(w.d) == int(e["state"]))
				or (int(w.a) == int(e["state"]) and int(w.d) == int(a["state"]))):
			var swing := 3.0 if int(winner["state"]) == int(w.a) else -3.0
			w.score = clampf(float(w.score) + swing, -100.0, 100.0)
			break
	var loser_name: String = gen.states[int(loser["state"])].name if int(loser["state"]) < gen.states.size() else "?"
	history.append({"date": date_str(),
		"text": "%s 在 %s 交战（%d vs %d），%s%s" % [camp["war_key"], gen.provinces[pi].get("name", ""),
			int(pa), int(pe), loser_name,
			"军覆灭" if str(loser["current_state"]) == "Destroyed" else "军败退"], "state": int(winner["state"])})
	if history.size() > 800:
		history = history.slice(history.size() - 600)

## 国家灭亡统一清理（P2）：军队覆灭标记、活跃战争终结、外交关系清空、历史记录
func _kill_state(si: int, by_si: int, how: String) -> void:
	if si < 0 or si >= gen.states.size() or not gen.states[si].alive:
		return
	gen.states[si].alive = false
	for a in armies:
		if int(a["state"]) == si and str(a["current_state"]) != "Destroyed":
			a["current_state"] = "Destroyed"
			a["army_count"] = -1.0
	for w in wars:
		if w.active and (int(w.a) == si or int(w.d) == si):
			w.active = false
			var winner2: int = by_si if (int(w.a) == by_si or int(w.d) == by_si) else (int(w.a) if int(w.d) == si else int(w.d))
			_record_war(w, "%s 因国家覆灭而终止（%s）" % [gen.states[winner2].name, how])
	var st: Dictionary = gen.states[si]
	st["allies"] = []
	st["vassal_of"] = -1
	history.append({"date": date_str(), "text": "【灭亡】%s %s" % [st.name, how], "state": by_si})
	if history.size() > 800:
		history = history.slice(history.size() - 600)

func _grow_population() -> void:
	# 人口增长受"最大人口"约束（原版 ProvinceInfoUI 的 当前人口/最大人口）
	for p in gen.provinces:
		var cap: int = int(p.get("max_pop", 0))
		var grown := int(p.pop * (1.0 + rules.pop_growth) + 1)
		p.pop = grown if cap <= 0 else mini(grown, cap)

func _alive_states() -> Array[int]:
	var out: Array[int] = []
	for si in gen.states.size():
		if gen.states[si].alive:
			out.append(si)
	return out

func _state_power(si: int) -> int:
	var power := 0
	for pi in gen.states[si].provinces:
		power += gen.provinces[pi].pop
	return maxi(power, 1)

## 联盟缔结（原版 AllowAllianceButton 的玩法效果）：相邻且非交战国之间按概率结盟，
## 文案用官方 AllianceFormedBetweenStates
func _try_alliances() -> void:
	if not bool(rules.allow_alliance):
		return
	for si in _alive_states():
		if gen.states[si].provinces.is_empty():
			continue
		if rng.randf() > 0.03:
			continue
		var cands: Array[int] = []
		for ti in _neighbor_states(si):
			if gen.states[si].get("allies", []).has(ti):
				continue
			if is_at_war(si) or is_at_war(ti):
				continue
			cands.append(ti)
		if cands.is_empty():
			continue
		var ti2: int = cands[rng.randi() % cands.size()]
		if not gen.states[si].has("allies"):
			gen.states[si].allies = []
		if not gen.states[ti2].has("allies"):
			gen.states[ti2].allies = []
		gen.states[si].allies.append(ti2)
		gen.states[ti2].allies.append(si)
		var txt: String = t("AllianceFormedBetweenStates", "{0}与{1}结成联盟").format({
			"0": gen.states[si].name, "1": gen.states[ti2].name})
		history.append({"date": date_str(), "text": txt, "state": si})
		history.append({"date": date_str(), "text": txt, "state": ti2})

## 自动放弃孤立行省（原版 AllowAutoAbandonIsolatedProvincesButton）：
## 行省与本国主体不连通、且四周邻省都不属本国 → 一年后放弃（官方 GlobalCommandTutorial 原文）
func _abandon_isolated_provinces() -> void:
	if not bool(rules.allow_auto_abandon_isolated):
		return
	for si in _alive_states():
		var provs: Array = gen.states[si].provinces.duplicate()
		if provs.size() <= 1:
			continue
		var capital: int = gen.states[si].capital
		if not provs.has(capital):
			continue
		var reachable := {}
		var stack: Array[int] = [capital]
		reachable[capital] = true
		while not stack.is_empty():
			var cur: int = stack.pop_back()
			for nb in gen.provinces[cur].neighbors:
				if reachable.has(nb):
					continue
				if gen.provinces[nb].state == si:
					reachable[nb] = true
					stack.append(nb)
		for pi in provs:
			if reachable.has(pi):
				gen.provinces[pi].isolated_months = 0
				continue
			var surrounded_by_others := true
			for nb2 in gen.provinces[pi].neighbors:
				if gen.provinces[nb2].state == si:
					surrounded_by_others = false
					break
			if not surrounded_by_others:
				gen.provinces[pi].isolated_months = 0
				continue
			var months: int = int(gen.provinces[pi].get("isolated_months", 0)) + 1
			gen.provinces[pi].isolated_months = months
			if months >= 12:
				gen.provinces[pi].state = -1
				gen.provinces[pi].isolated_months = 0
				var txt2: String = t("IsolatedProvinceAbandoned", "%s 放弃了孤立行省 %s") % [
					gen.states[si].name, gen.provinces[pi].name]
				history.append({"date": date_str(), "text": txt2, "state": si})
	gen.rebuild_after_state_edit()

