func t(key: String, fallback: String) -> String:
	return zh.get(key, fallback)

func setup(g: MapGen, seed_val: int) -> void:
	_sim_rng.seed = seed_val * 104729 + 7
	gen = g
	rng.seed = seed_val + 7
	wars.clear()
	war_records.clear()
	truces.clear()
	next_war_id = 1
	var zf := FileAccess.open("res://assets/origin/zh_strings.json", FileAccess.READ)
	if zf:
		var parsed: Variant = JSON.parse_string(zf.get_as_text())
		if parsed is Dictionary:
			zh = parsed
	_init_armies()
	# 军队实体初始化（2026-11-01 修复：此前只有测试调用，真实模拟中 armies 为空，
	# 军队从未移动/战斗——世界因此没有战争）
	armies.clear()
	campaigns.clear()
	for si in gen.states.size():
		_init_armies_for_state(si)
	apply_mods()

## 军队/战舰初始化：原版 StateInfoUI 有 Army / WarshipCount 字段（军队部署）
