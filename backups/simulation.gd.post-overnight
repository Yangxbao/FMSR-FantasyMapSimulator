## 全局指令：重新生成区域（原版 RegenerateDistrictsButton）
## 重建版区域是行省的子字段 → 按行省规模重新分配区域人口/防御上限
func regenerate_districts() -> void:
	var rng2 := RandomNumberGenerator.new()
	rng2.seed = year * 131 + month * 17
	for p in gen.provinces:
		if p.get("is_sea", false):
			continue
		var n: int = p.cells.size()
		p.district_max_pop = maxi(50, n * rng2.randi_range(8, 18))
		p.district_pop = int(float(p.district_max_pop) * rng2.randf_range(0.25, 0.8))
		p.district_max_defense = maxi(30, n * rng2.randi_range(2, 5))
		p.district_defense = int(float(p.district_max_defense) * rng2.randf_range(0.3, 0.9))
	history.append({"date": date_str(), "text": t("DistrictRegenerated", "已重新生成所有区域")})

func _diplomacy_and_war() -> void:
	_advance_wars()
	var alive := _alive_states()
	for si in alive:
		if si >= gen.states.size() or not gen.states[si].alive:
			continue
		if is_at_war(si):
			continue  # 已在战争中不再另开战线（原版同一时刻只打一场主要战争）
		var roll := rng.randf()
		if roll < rules.war_chance_per_month:
			_try_war(si)
		elif roll < rules.war_chance_per_month + rules.expand_pressure:
			_try_peaceful_expansion(si)

func is_at_war(si: int) -> bool:
	for w in wars:
		if w.active and (int(w.a) == si or int(w.d) == si):
			return true
	return false

## 该国参与的所有战争（默认只看进行中的）
func state_wars(si: int, only_active := true) -> Array:
	var out: Array = []
	for w in wars:
		if only_active and not w.active:
			continue
		if int(w.a) == si or int(w.d) == si:
			out.append(w)
	return out

func _neighbor_states(si: int) -> Array[int]:
	var seen := {}
	var out: Array[int] = []
	for pi in gen.states[si].provinces:
		for nb in gen.provinces[pi].neighbors:
			var os: int = gen.provinces[nb].state
			if os >= 0 and os != si and gen.states[os].alive and not seen.has(os):
				seen[os] = true
				out.append(os)
	return out

func _try_war(si: int) -> void:
	var targets := _neighbor_states(si)
	if targets.is_empty():
		return
	var cands2: Array[int] = []
	for t2 in targets:
		if not _in_truce(si, t2):
			cands2.append(t2)
	if cands2.is_empty():
		return
	var ti: int = cands2[rng.randi() % cands2.size()]
	var my := _state_power(si)
	var foe := _state_power(ti)
	# 类型/目标按国力对比挑选（原版 WarManagerV2 有 12 种类型、多种战争目标）
	var type_key := "WarTypeConquest"
	var goal_key := "WarGoalCedeProvince"
	if my > foe * 3.0:
		goal_key = "WarGoalAnnex"
	elif my < foe * 0.5:
		type_key = "WarTypeLiberation"
		goal_key = "WarGoalOccupyCount"
	elif bool(rules.enable_vassal) and rng.randf() < 0.25:
		type_key = "WarTypeVassalization"
		goal_key = "WarV2_GoalVassalize"
	declare_war(si, ti, type_key, goal_key)

## 宣战：写入战争列表 + 历史（文案用原版 WarV2_Declared）
## P4 外交闭环（重建版规则，标注）：活跃盟友有 50% 概率卷入战争（写入
## aggressor_allies/defender_allies，原版 War schema 字段）；交战双方进入停战登记。
func declare_war(a: int, d: int, type_key: String, goal_key: String) -> int:
	_mobilize_armies(a)
	_mobilize_armies(d)
	var agg_allies: Array = []
	var def_allies: Array = []
	if bool(rules.allow_alliance):
		for al in gen.states[a].get("allies", []):
			if agg_allies.size() >= 2:
				break
			var ali: int = int(al)
			if ali < gen.states.size() and gen.states[ali].alive and not is_at_war(ali) and rng.randf() < 0.5:
				agg_allies.append(ali)
				_mobilize_armies(ali)
		for al2 in gen.states[d].get("allies", []):
			if def_allies.size() >= 2:
				break
			var ali2: int = int(al2)
			if ali2 < gen.states.size() and gen.states[ali2].alive and not is_at_war(ali2) \
					and not agg_allies.has(ali2) and rng.randf() < 0.5:
				def_allies.append(ali2)
				_mobilize_armies(ali2)
	var w := {"id": next_war_id, "a": a, "d": d, "type": type_key, "goal": goal_key,
		"months": 0, "score": 0.0, "active": true, "ceded": [],
		"attacker": a, "defender": d,
		"war_state": 1, "min_month_before_war_end": 24, "is_fight_to_the_end": false,
		"aggressor_allies": agg_allies, "defender_allies": def_allies}
	next_war_id += 1
	wars.append(w)
	var short_goal: String = t(goal_key, goal_key)
	if goal_key == "WarGoalAnnex":
		short_goal = t("WarGoalAnnex", "吞并")
	var text: String = t("WarV2_Declared", "{0}以{1}为由对{2}宣战，目标：{3}").format({
		"0": gen.states[a].name, "1": short_goal,
		"2": gen.states[d].name, "3": t("WarV2_GoalAnnex" if goal_key == "WarGoalAnnex" else goal_key, short_goal)})
	history.append({"date": date_str(), "text": text, "state": a})
	history.append({"date": date_str(), "text": text, "state": d})
	for al3 in agg_allies:
		history.append({"date": date_str(), "text": "%s 履行盟约加入 %s 一方" % [gen.states[int(al3)].name, gen.states[a].name], "state": int(al3)})
	for al4 in def_allies:
		history.append({"date": date_str(), "text": "%s 履行盟约加入 %s 一方" % [gen.states[int(al4)].name, gen.states[d].name], "state": int(al4)})
	return int(w.id)

## 停战期（P4 重建规则）：战后 minMonthToBeginAnotherWar 个月内两国不得再开战
func _in_truce(sa: int, sb: int) -> bool:
	for t3 in truces:
		if int(t3.months) > 0 and ((int(t3.a) == sa and int(t3.d) == sb) or (int(t3.a) == sb and int(t3.d) == sa)):
			return true
	return false

func _advance_truces() -> void:
	var out := []
	for t4 in truces:
		t4.months = int(t4.months) - 1
		if int(t4.months) > 0:
			out.append(t4)
	truces = out

## 敌对判定（P4）：直接交战，或处于同一场战争的对立阵营（盟友参战）
func _are_hostile(sa: int, sb: int) -> bool:
	for w in wars:
		if not w.active:
			continue
		var side_a := -1
		if int(w.a) == sa or (w.get("aggressor_allies", []) as Array).has(sa):
			side_a = 0
		elif int(w.d) == sa or (w.get("defender_allies", []) as Array).has(sa):
			side_a = 1
		if side_a < 0:
			continue
		var side_b := -1
		if int(w.a) == sb or (w.get("aggressor_allies", []) as Array).has(sb):
			side_b = 0
		elif int(w.d) == sb or (w.get("defender_allies", []) as Array).has(sb):
			side_b = 1
		if side_b >= 0 and side_a != side_b:
			return true
	return false

## 月度推进：战争分数累积 + 战时占领（原版 WarScore / WarResults 的表现面）
func _advance_wars() -> void:
	for w in wars:
		if not w.active:
			continue
		var a: int = int(w.a)
		var d: int = int(w.d)
		if not gen.states[a].alive or not gen.states[d].alive:
			w.active = false
			continue
		w.months = int(w.months) + 1
		if int(w.months) >= int(rules.max_war_duration_months):
			_settle_war(w)
			continue
		var pa := float(_state_power(a)) * (1.0 + float(gen.states[a].army) * 0.05)
		var pd := float(_state_power(d)) * (1.0 + float(gen.states[d].army) * 0.05)
		var ratio := (pa - pd) / maxf(pa, pd)
		w.score = clampf(float(w.score) + ratio * 12.0 + rng.randf_range(-4.0, 4.0), -100.0, 100.0)
		if absf(float(w.score)) > 45.0 and rng.randf() < 0.18:
			var winner: int = a if float(w.score) > 0.0 else d
			var loser: int = d if winner == a else a
			if gen.states[loser].provinces.size() > 1:
				var bp := _border_province_of(loser, winner)
				if bp >= 0:
					_transfer(bp, loser, winner, "战争占领")
					w.ceded.append(bp)
		if absf(float(w.score)) >= 100.0:
			_settle_war(w)

func _dur_text(months: int) -> String:
	var y := months / 12
	var m := months % 12
	if y > 0 and m > 0:
		return t("WarV2_StatsSuffix", "，历时{0}").format({"0": t("WarV2_DurYM", "{0}年{1}个月").format({"0": y, "1": m})})
	if y > 0:
		return t("WarV2_StatsSuffix", "，历时{0}").format({"0": t("WarV2_DurY", "{0}年").format({"0": y})})
	return t("WarV2_StatsSuffix", "，历时{0}").format({"0": t("WarV2_DurM", "{0}个月").format({"0": maxi(m, 1)})})

## 战争结算：按目标执行领土/赔款/附庸条款，并写战报（原版 WarRecord）
func _settle_war(w: Dictionary) -> void:
	w.active = false
	w["ended"] = true
	var a: int = int(w.a)
	var d: int = int(w.d)
	# 停战期登记（重建规则，时长 = rules.min_month_to_begin_another_war）
	truces.append({"a": a, "d": d, "months": int(rules.get("min_month_to_begin_another_war", 12))})
	# 战争结算：被"控制"的省正式转移给占领者（控制权→所有权，schema 依据 warState+结算流程）
	var occupied_a := []   # a 控制的原 d 省份
	var occupied_d := []   # d 控制的原 a 省份
	for pi in gen.provinces.size():
		var ob: int = int(gen.provinces[pi].get("occupied_by", -1))
		if ob == a and int(gen.provinces[pi].get("state", -1)) == d:
			occupied_a.append(pi)
		elif ob == d and int(gen.provinces[pi].get("state", -1)) == a:
			occupied_d.append(pi)
	for pi in occupied_a:
		_transfer(pi, d, a, "settled_occupation")
	for pi in occupied_d:
		_transfer(pi, a, d, "settled_occupation")
	# 军队复员：清控制标记、回 Idle、清目标（含参战盟友，P4）
	var participants: Array = [a, d]
	for al in (w.get("aggressor_allies", []) as Array) + (w.get("defender_allies", []) as Array):
		participants.append(int(al))
	for a2 in armies:
		if participants.has(int(a2["state"])):
			a2["army_order"] = "HoldPosition"
			a2["current_state"] = "Idle"
			a2["target_province"] = -1
			a2["march_months"] = 0
	for c in campaigns:
		if int(c.get("is_active", 0)) == 1 and (int(c["war_key"].split("-")[0]) == a or int(c["war_key"].split("-")[0]) == d):
			c["is_active"] = false
			c["end_time"] = float(year) + float(month) / 12.0
	var score: float = float(w.score)
	var dur := _dur_text(int(w.months))
	var attacker_won := score > 0.0
	var winner: int = a if attacker_won else d
	var loser: int = d if attacker_won else a
	var clause := ""
	if absf(score) < 30.0:
		_record_war(w, t("WarV2_SettledStalemate", "{0}与{1}停战，{2}").format({
			"0": gen.states[a].name, "1": gen.states[d].name, "2": ""}) + dur)
		return
	var goal: String = str(w.goal)
	if attacker_won and goal == "WarGoalAnnex":
		var provs: Array = gen.states[loser].provinces.duplicate()
		for pi in provs:
			_move_province(int(pi), loser, winner)
		_kill_state(loser, winner, t("WarV2_SettledAnnex", "{0}击灭并吞并{1}").format({
			"0": gen.states[winner].name, "1": gen.states[loser].name}))
		_record_war(w, t("WarV2_SettledAnnex", "{0}击灭并吞并{1}，{2}").format({
			"0": gen.states[winner].name, "1": gen.states[loser].name, "2": ""}) + dur)
		return
	if attacker_won and goal == "WarV2_GoalVassalize":
		gen.states[loser].vassal_of = winner
		clause = t("Vassal", "附庸") + gen.states[winner].name
	elif attacker_won and goal == "WarV2_GoalReparations":
		for pi in gen.states[loser].provinces:
			gen.provinces[pi].pop = int(gen.provinces[pi].pop * 0.8)
		clause = "索取赔款"
	else:
		# 割让 / 占领：转移 1~2 个边境省
		var take := 2 if goal == "WarGoalOccupyCount" else 1
		for _i in take:
			if gen.states[loser].provinces.size() <= 1:
				break
			var bp := _border_province_of(loser, winner)
			if bp < 0:
				break
			var receiver := winner
			if bool(rules.assist_allies_occupy_land) and not _touches_state(bp, winner):
				for ally in gen.states[winner].get("allies", []):
					if _touches_state(bp, int(ally)):
						receiver = int(ally)
						break
			_move_province(bp, loser, receiver)
			clause += t("WarV2_CededClause", "，割得{0}省").format({"0": gen.provinces[bp].name})
	if gen.states[loser].alive:
		var line := ""
		if attacker_won:
			line = t("WarV2_SettledAttackerWin", "{0}战胜{1}，{2}").format({
				"0": gen.states[winner].name, "1": gen.states[loser].name, "2": clause})
		else:
			line = t("WarV2_SettledDefenderWin", "{0}击退{1}，{2}").format({
				"0": gen.states[winner].name, "1": gen.states[loser].name, "2": clause})
		_record_war(w, line + dur)
	else:
		_record_war(w, t("WarV2_SettledAnnex", "{0}击灭并吞并{1}，{2}").format({
			"0": gen.states[winner].name, "1": gen.states[loser].name, "2": ""}) + dur)

## 该行省是否与指定国家相邻（协助盟友占领土地的判定）
func _touches_state(pi: int, si: int) -> bool:
	if si < 0 or si >= gen.states.size():
		return false
	for nb in gen.provinces[pi].neighbors:
		if gen.provinces[nb].state == si:
			return true
	return false

func _record_war(w: Dictionary, text: String) -> void:
	war_records.append({"date": date_str(), "text": text, "a": int(w.a), "d": int(w.d),
		"type": str(w.type), "goal": str(w.goal), "score": snappedf(float(w.score), 1.0),
		"months": int(w.months)})
	history.append({"date": date_str(), "text": text, "state": int(w.a)})
	history.append({"date": date_str(), "text": text, "state": int(w.d)})
	if history.size() > 800:
		history = history.slice(history.size() - 600)

## 只搬家不写历史（用于吞并等批量转移，最后由 _record_war 统一记一条）
func _move_province(pi: int, from_si: int, to_si: int) -> void:
	gen.provinces[pi].state = to_si
	gen.provinces[pi]["occupied_by"] = -1   # 正式转移后控制标记消失（控制权→所有权完成）
	gen.states[from_si].provinces.erase(pi)
	if not gen.states[to_si].provinces.has(pi):
		gen.states[to_si].provinces.append(pi)
	if gen.states[from_si].provinces.is_empty():
		gen.states[from_si].alive = false

func _try_peaceful_expansion(si: int) -> void:
	# 无主/衰败邻近省份的和平吞并（附庸化简化模型）
	# 注意：迭代副本 —— _transfer 会向 provinces 数组追加元素，直接迭代会死循环
	var own: Array = gen.states[si].provinces.duplicate()
	for pi in own:
		for nb in gen.provinces[pi].neighbors:
			var os: int = gen.provinces[nb].state
			if os >= 0 and os != si and gen.states[os].alive:
				if _state_power(os) < _state_power(si) * 0.12 and rng.randf() < 0.25:
					_transfer(nb, os, si, "和平统一")
					return

func _border_province_of(from_si: int, to_si: int) -> int:
	var cands: Array[int] = []
	for pi in gen.states[from_si].provinces:
		for nb in gen.provinces[pi].neighbors:
			if gen.provinces[nb].state == to_si:
				cands.append(pi)
				break
	if cands.is_empty():
		return -1
	return cands[rng.randi() % cands.size()]

func _transfer(pi: int, from_si: int, to_si: int, how: String) -> void:
	var died: bool = gen.states[from_si].provinces.size() <= 1
	_move_province(pi, from_si, to_si)
	if died:
		# 国家灭亡统一清理（军队/战争/外交），替代原先只写历史的做法
		_kill_state(from_si, to_si, "被 %s %s" % [gen.states[to_si].name, how])
	else:
		var txt2 := "%s 从 %s %s省份 %s" % [gen.states[to_si].name, gen.states[from_si].name, how, gen.provinces[pi].name]
		history.append({"date": date_str(), "text": txt2, "state": to_si})
		history.append({"date": date_str(), "text": txt2, "state": from_si})
	if history.size() > 800:
		history = history.slice(history.size() - 600)

# ---------- 存档（JSON, 无加密, 版本号前向兼容） ----------
const SAVE_VERSION := 3   # v3：新增高度图/陆海/群系数据（编辑器改动可随存档保留）

func save(path: String) -> bool:
	var data := {
		"version": SAVE_VERSION,
		"year": year, "month": month,
		"cell_province": var_to_str(gen.cell_province).replace("\n", ""),
		# 编辑器改动的地形/群系必须随存档保留（base64 二进制，体积约 1/3）
		"elevation_b64": Marshalls.raw_to_base64(gen.elevation.to_byte_array()),
		"is_land_b64": Marshalls.raw_to_base64(gen.is_land),
		"biome_b64": Marshalls.raw_to_base64(gen.biome),
		"provinces": [],
		"states": [],
		"wars": wars,
		"war_records": war_records,
		"truces": truces,
		"next_war_id": next_war_id,
		"history": history,
		"rules": rules,
	}
	for p in gen.provinces:
		data.provinces.append({"name": p.name, "pop": p.pop, "defense": p.defense,
			"state": p.state, "kind": p.get("kind", ""),
			"max_pop": p.get("max_pop", 0), "max_defense": p.get("max_defense", 0),
			"district_pop": p.get("district_pop", 0), "district_max_pop": p.get("district_max_pop", 0),
			"district_defense": p.get("district_defense", 0), "district_max_defense": p.get("district_max_defense", 0),
			"is_capital_burg": p.is_capital_burg})
	for st in gen.states:
		data.states.append({"name": st.name, "alive": st.alive, "polity": st.polity,
			"capital": st.capital, "auto_diplomacy": st.get("auto_diplomacy", true),
			"leader": st.get("leader", {}), "culture": st.get("culture", ""),
			"religion": st.get("religion", ""), "army": st.get("army", 0),
			"warships": st.get("warships", 0), "allies": st.get("allies", []),
			"vassal_of": st.get("vassal_of", -1), "color": st.color,
			"gold": st.get("gold", 0.0), "gold_per_month": st.get("gold_per_month", 0.0),
			"armies_initialized": st.get("armies_initialized", 0)})
	data.armies = armies
	data.campaigns = campaigns
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		return false
	f.store_string(JSON.stringify(data))
	f.close()
	return true

func load(path: String) -> bool:
	var txt := FileAccess.get_file_as_string(path)
	if txt.is_empty():
		return false
	var data: Variant = JSON.parse_string(txt)
	if not (data is Dictionary):
		return false
	var ver := int(data.get("version", 0))
	if ver < 1:
		return false
	year = int(data.year)
	month = int(data.month)
	history = data.get("history", [])
	wars = data.get("wars", [])
	truces = data.get("truces", [])
	armies = data.get("armies", [])
	campaigns = data.get("campaigns", [])
	war_records = data.get("war_records", [])
	next_war_id = int(data.get("next_war_id", 1))
	if data.has("rules"):
		for k in data.rules:
			if rules.has(k):
				rules[k] = data.rules[k]
	var cp: Array = str_to_var(String(data.cell_province))
	gen.cell_province = PackedInt32Array(cp)
	if data.has("elevation_b64"):
		var eb := Marshalls.base64_to_raw(str(data.elevation_b64))
		var ea := eb.to_float32_array()
		if ea.size() == gen.elevation.size():
			gen.elevation = ea
	if data.has("is_land_b64"):
		var lb := Marshalls.base64_to_raw(str(data.is_land_b64))
		if lb.size() == gen.is_land.size():
			gen.is_land = lb
	if data.has("biome_b64"):
		var bb := Marshalls.base64_to_raw(str(data.biome_b64))
		if bb.size() == gen.biome.size():
			gen.biome = bb
	# 行省字段按存档回填（v1 只有 name/pop）
	var provs: Array = data.get("provinces", [])
	for i in mini(gen.provinces.size(), provs.size()):
		var src: Dictionary = provs[i]
		gen.provinces[i].name = str(src.get("name", gen.provinces[i].name))
		gen.provinces[i].pop = int(src.get("pop", gen.provinces[i].pop))
		gen.provinces[i].defense = int(src.get("defense", gen.provinces[i].defense))
		gen.provinces[i].kind = str(src.get("kind", ""))
		gen.provinces[i].max_pop = int(src.get("max_pop", 0))
		gen.provinces[i].max_defense = int(src.get("max_defense", 0))
		gen.provinces[i].district_pop = int(src.get("district_pop", 0))
		gen.provinces[i].district_max_pop = int(src.get("district_max_pop", 0))
		gen.provinces[i].district_defense = int(src.get("district_defense", 0))
		gen.provinces[i].district_max_defense = int(src.get("district_max_defense", 0))
		gen.provinces[i].is_capital_burg = bool(src.get("is_capital_burg", false))
	var sts: Array = data.get("states", [])
	for si in mini(gen.states.size(), sts.size()):
		var d: Dictionary = sts[si]
		gen.states[si].name = str(d.get("name", gen.states[si].name))
		gen.states[si].alive = bool(d.get("alive", true))
		gen.states[si].polity = str(d.get("polity", gen.states[si].polity))
		gen.states[si].capital = int(d.get("capital", gen.states[si].capital))
		gen.states[si].auto_diplomacy = bool(d.get("auto_diplomacy", true))
		gen.states[si].leader = d.get("leader", gen.states[si].get("leader", {}))
		gen.states[si].culture = str(d.get("culture", ""))
		gen.states[si].religion = str(d.get("religion", ""))
		gen.states[si].army = int(d.get("army", 0))
		gen.states[si].warships = int(d.get("warships", 0))
		gen.states[si].allies = d.get("allies", [])
		gen.states[si].vassal_of = int(d.get("vassal_of", -1))
		gen.states[si].gold = float(d.get("gold", 0.0))
		gen.states[si].gold_per_month = float(d.get("gold_per_month", 0.0))
		gen.states[si]["armies_initialized"] = int(d.get("armies_initialized", 0))
	# 国家-行省归属按 cell→province 字典重建（修正 v1 把 province id 当 state id 的缺陷）
	for st in gen.states:
		st.provinces.clear()
	for pi in gen.provinces.size():
		var owner_state: int = gen.provinces[pi].state
		if owner_state >= 0 and owner_state < gen.states.size():
			gen.states[owner_state].provinces.append(pi)
		else:
			gen.provinces[pi].state = -1
	map_changed.emit()
	return true


# ============================================================================
# 国家面板的"国家行为"（对齐原版 StateInfoUI 按钮面：扩张/煽动叛乱/内战/吞并/发起战争/停战/
# 缔结盟约/退出同盟/收为附庸/独立/腐败度/放置军队）。每个按钮都有真实数据后果。
# ============================================================================

## 扩张：对无主/弱邻行省做一次和平蚕食（复用月度扩张逻辑）
func act_expand(si: int) -> String:
	if si < 0 or si >= gen.states.size() or not gen.states[si].alive:
		return "国家不存在"
	var before: int = gen.states[si].provinces.size()
	_try_peaceful_expansion(si)
	var after: int = gen.states[si].provinces.size()
	if after > before:
		return "扩张成功：+%d 行省" % (after - before)
	return "无可扩张目标（周边无弱国/无主行省）"

## 煽动叛乱：在邻国边境省扶植叛乱政权，并立刻进入战争
func act_incite_rebellion(si: int) -> String:
	if not bool(rules.allow_rebellion):
		return "全局指令已关闭叛乱"
	var neigh := _neighbor_states(si)
	if neigh.is_empty():
		return "没有接壤国家可煽动"
	var ti: int = neigh[rng.randi() % neigh.size()]
	if gen.states[ti].provinces.size() <= 1:
		return "%s 只有 1 个行省，无法煽动" % gen.states[ti].name
	var victim: int = gen.states[ti].provinces[rng.randi() % gen.states[ti].provinces.size()]
	var new_si := gen.add_state(gen.provinces[victim].name + "义军")
	gen.provinces[victim].state = new_si
	gen.provinces[victim].is_capital_burg = true
	gen.states[new_si].capital = victim
	gen.states[new_si].color = gen.states[si].color.darkened(0.15)
	gen.rebuild_after_state_edit()
	declare_war(new_si, ti, "WarTypeRebel", "WarGoalOccupyCount")
	history.append({"date": date_str(), "state": si,
		"text": "%s 煽动 %s 的 %s 叛乱" % [gen.states[si].name, gen.states[ti].name, gen.provinces[victim].name]})
	return "已煽动 %s 叛乱（%s）" % [gen.provinces[victim].name, gen.states[new_si].name]

## 内战：本国一半行省（不含首都）分裂为叛乱国并开战
func act_civil_war(si: int) -> String:
	if not bool(rules.allow_civil_war):
		return "全局指令已关闭内战"
	if gen.states[si].provinces.size() < 4:
		return "行省太少，无法内战"
	var capital: int = gen.states[si].capital
	var pool: Array = []
	for pi in gen.states[si].provinces:
		if pi != capital:
			pool.append(pi)
	var take: int = maxi(1, pool.size() / 2)
	var new_si := gen.add_state(gen.states[si].name + "内战军")
	for k in take:
		var pi2: int = pool[pool.size() - 1 - k]
		gen.provinces[pi2].state = new_si
	gen.states[new_si].capital = int(gen.states[new_si].provinces[0]) if not gen.states[new_si].provinces.is_empty() else -1
	gen.rebuild_after_state_edit()
	if gen.states[new_si].provinces.is_empty():
		return "内战未爆发"
	gen.states[new_si].capital = gen.states[new_si].provinces[0]
	declare_war(new_si, si, "WarTypeCivilWar", "WarGoalOccupyCount")
	return "内战爆发：%s 分裂出 %s（%d 省）" % [gen.states[si].name, gen.states[new_si].name, take]

## 吞并：国力碾压时直接吞并最弱邻国（原版"吞并"按钮的强条件版本）
func act_annex(si: int) -> String:
	var neigh := _neighbor_states(si)
	if neigh.is_empty():
		return "没有可吞并的邻国"
	var weakest := -1
	var wp := 1 << 30
	for ti in neigh:
		var p := _state_power(ti)
		if p < wp:
			wp = p
			weakest = ti
	if weakest < 0:
		return "没有可吞并的邻国"
	if _state_power(si) < wp * 3:
		return "国力不足（需 3 倍于 %s）" % gen.states[weakest].name
	var nm: String = gen.states[weakest].name
	for pi in gen.states[weakest].provinces.duplicate():
		gen.provinces[pi].state = si
	gen.rebuild_after_state_edit()
	history.append({"date": date_str(), "state": si,
		"text": "%s 吞并了 %s" % [gen.states[si].name, nm]})
	return "已吞并 " + nm

## 发起战争：对随机邻国宣战（目标按国力对比）
func act_declare_war(si: int) -> String:
	if is_at_war(si):
		return "已在战争中"
	var neigh := _neighbor_states(si)
	if neigh.is_empty():
		return "没有邻国"
	var ti: int = neigh[rng.randi() % neigh.size()]
	var goal := "WarGoalCedeProvince"
	if _state_power(si) > _state_power(ti) * 3:
		goal = "WarGoalAnnex"
	declare_war(si, ti, "WarTypeConquest", goal)
	return "已对 %s 宣战" % gen.states[ti].name

## 停战：结束本国全部战争
func act_peace(si: int) -> String:
	var n := 0
	for w in wars:
		if w.active and (int(w.a) == si or int(w.d) == si):
			w.active = false
			n += 1
	if n == 0:
		return "没有进行中的战争"
	history.append({"date": date_str(), "state": si, "text": "%s 停战（%d 场）" % [gen.states[si].name, n]})
	return "已停战 %d 场" % n

## 缔结盟约 / 退出同盟
func act_alliance(si: int) -> String:
	if not bool(rules.allow_alliance):
		return "全局指令已关闭联盟"
	var neigh := _neighbor_states(si)
	for ti in neigh:
		if not gen.states[si].get("allies", []).has(ti):
			gen.states[si].allies.append(ti)
			gen.states[ti].allies.append(si)
			history.append({"date": date_str(), "state": si,
				"text": t("AllianceFormedBetweenStates", "{0}与{1}结成联盟").format({
					"0": gen.states[si].name, "1": gen.states[ti].name})})
			return "已与 %s 结盟" % gen.states[ti].name
	return "周边已全部结盟"

func act_break_alliance(si: int) -> String:
	var n: int = gen.states[si].get("allies", []).size()
	for ti in gen.states[si].get("allies", []):
		gen.states[ti].allies.erase(si)
	gen.states[si].allies = []
	if n == 0:
		return "没有同盟"
	history.append({"date": date_str(), "state": si, "text": "%s 退出所有同盟（%d）" % [gen.states[si].name, n]})
	return "已退出 %d 个同盟" % n

## 收为附庸 / 独立
func act_make_vassal(si: int) -> String:
	if not bool(rules.enable_vassal):
		return "全局指令已关闭附庸"
	var neigh := _neighbor_states(si)
	var weakest := -1
	var wp := 1 << 30
	for ti in neigh:
		if int(gen.states[ti].get("vassal_of", -1)) >= 0:
			continue
		var p := _state_power(ti)
		if p < wp:
			wp = p
			weakest = ti
	if weakest < 0:
		return "没有可收为附庸的邻国"
	if _state_power(si) < wp * 2:
		return "国力不足（需 2 倍于 %s）" % gen.states[weakest].name
	gen.states[weakest].vassal_of = si
	history.append({"date": date_str(), "state": si,
		"text": "%s 收 %s 为附庸" % [gen.states[si].name, gen.states[weakest].name]})
	return "已收 %s 为附庸" % gen.states[weakest].name

func act_release_vassal(si: int) -> String:
	var n := 0
	for ti in gen.states.size():
		if int(gen.states[ti].get("vassal_of", -1)) == si:
			gen.states[ti].vassal_of = -1
			n += 1
	if int(gen.states[si].get("vassal_of", -1)) >= 0:
		gen.states[si].vassal_of = -1
		n += 1
	return "已解除 %d 个附庸关系" % n

## 腐败度调整（原版按钮"降低/加深"）
func act_corruption(si: int, delta: int) -> String:
	var v: int = clampi(int(gen.states[si].get("corruption", 20)) + delta, 0, 100)
	gen.states[si].corruption = v
	return "腐败度 %s（%d）" % [corruption_label(v), v]

func corruption_label(v: int) -> String:
	if v < 20:
		return "清廉"
	if v < 45:
		return "轻度腐败"
	if v < 70:
		return "中度腐败"
	return "严重腐败"

## 放置军队（原版"输入军团数量 + 放置军队"）
func act_add_army(si: int, n: int) -> String:
	gen.states[si].army = maxi(0, int(gen.states[si].get("army", 0)) + n)
	return "军队数量：%d" % int(gen.states[si].army)
